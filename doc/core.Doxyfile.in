# Doxygen configuration of the documentation of evocomb::core.
@INCLUDE               = @EVOCOMB_DOC_BUILD_DIR@/Doxyfile.common

PROJECT_NAME           = "evocomb::core"
PROJECT_BRIEF          = "EvoComb - Core (tools, I/O, matrices, graphs, geometry)"
INPUT                  = @PROJECT_SOURCE_DIR@/doc/evocomb.dox @PROJECT_SOURCE_DIR@/doc/core_groups.dox @PROJECT_SOURCE_DIR@/doc/core.md @PROJECT_SOURCE_DIR@/src/core
USE_MDFILE_AS_MAINPAGE = @PROJECT_SOURCE_DIR@/doc/core.md
STRIP_FROM_PATH        = @PROJECT_SOURCE_DIR@/src/core
STRIP_FROM_INC_PATH    = @PROJECT_SOURCE_DIR@/src/core
HTML_OUTPUT            = core
HTML_HEADER            = @EVOCOMB_DOC_HTML_HEADER@

# The classes are grouped by directory (see cmake/EvoCombDocFilter.cmake)
INPUT_FILTER           = @EVOCOMB_DOC_INPUT_FILTER@
WARN_LOGFILE           = @EVOCOMB_DOC_BUILD_DIR@/core_warnings.log

# Tag file used by the documentation of evocomb::optimization and by the projects
# using EvoComb (see EVOCOMB_DOXYGEN_TAGFILES in EvoCombConfig.cmake)
GENERATE_TAGFILE       = @EVOCOMB_DOC_DIR@/core/evocomb_core.tag
