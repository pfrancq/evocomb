# Doxygen settings shared by the documentation of all the EvoComb libraries (see
# core.Doxyfile.in and optimization.Doxyfile.in). CMake replaces the @VAR@
# variables (see cmake/EvoCombDoc.cmake).

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NUMBER         = @PROJECT_VERSION@
OUTPUT_DIRECTORY       = @EVOCOMB_DOC_DIR@
OUTPUT_LANGUAGE        = English
INPUT_ENCODING         = UTF-8
FULL_PATH_NAMES        = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
TAB_SIZE               = 4

#---------------------------------------------------------------------------
# What is documented
#---------------------------------------------------------------------------
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
SHOW_INCLUDE_FILES     = YES
SORT_MEMBER_DOCS       = NO
GENERATE_TODOLIST      = NO
GENERATE_TESTLIST      = NO
GENERATE_BUGLIST       = NO
GENERATE_DEPRECATEDLIST= YES

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
FILE_PATTERNS          = *.hpp *.md *.dox
RECURSIVE              = YES
EXCLUDE_SYMBOLS        = evocomb::detail
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
PREDEFINED             = EVOCOMB_DEBUG_LOG

#---------------------------------------------------------------------------
# Messages (written in the build directory to keep the build output clean)
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES

#---------------------------------------------------------------------------
# Output: HTML only
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
SOURCE_BROWSER         = NO
HTML_DYNAMIC_SECTIONS  = YES

#---------------------------------------------------------------------------
# Diagrams (with dot if it is installed)
#---------------------------------------------------------------------------
HAVE_DOT               = @EVOCOMB_DOC_HAVE_DOT@
DOT_PATH               = @EVOCOMB_DOC_DOT_PATH@
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

#---------------------------------------------------------------------------
# Formulas (rendered by MathJax in the browser)
#---------------------------------------------------------------------------
USE_MATHJAX            = YES

#---------------------------------------------------------------------------
# Theme: doxygen-awesome-css, "sidebar-only" variant (see doc/doxygen-awesome)
#---------------------------------------------------------------------------
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
HTML_EXTRA_STYLESHEET  = @EVOCOMB_DOC_THEME_DIR@/doxygen-awesome.css \
                         @EVOCOMB_DOC_THEME_DIR@/doxygen-awesome-sidebar-only.css \
                         @EVOCOMB_DOC_THEME_DIR@/doxygen-awesome-sidebar-only-darkmode-toggle.css \
                         @PROJECT_SOURCE_DIR@/doc/evocomb-theme.css
HTML_EXTRA_FILES       = @EVOCOMB_DOC_THEME_DIR@/doxygen-awesome-darkmode-toggle.js \
                         @EVOCOMB_DOC_THEME_DIR@/doxygen-awesome-fragment-copy-button.js \
                         @EVOCOMB_DOC_THEME_DIR@/doxygen-awesome-paragraph-link.js \
                         @EVOCOMB_DOC_THEME_DIR@/doxygen-awesome-interactive-toc.js
